# Every environment variable the code reads, with a placeholder and never a real value.
# Copy this file to .env (git-ignored) and fill it in locally.
# Add a line here whenever the code starts reading a new variable.

# Anthropic API key. Only the rate command uses it.
ANTHROPIC_API_KEY=replace-me

# The model that rates. Keep one model for a whole run.
RATER_MODEL=claude-opus-5-5

# Congress.gov API key (free, from https://api.congress.gov/sign-up/). Only the votes command uses it.
CONGRESS_API_KEY=replace-me
